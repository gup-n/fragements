# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
dist-*/
dist-web-*/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# 安装包产物（发布走 GitHub Release，不入库）
*.apk
*.aab

# 编译校验产物（npm run build:web 生成，脚本跑完自己删；这条是异常中断时的兜底）
/.tmp-bundle
expo-qr.png

# 本地日志与临时文件
*.log
err.txt

# 纯函数断言脚本的编译产物
.tmp-assert/
