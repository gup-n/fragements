# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
dist-*/
dist-web-*/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# 安装包产物（发布走 GitHub Release，不入库）
*.apk
*.aab

# 编译校验产物（npm run build:web 生成，脚本跑完自己删；这条是异常中断时的兜底）
/.tmp-bundle
expo-qr.png

# PDF.js 构建副产物。运行期只加载 assets/pdfjs/reader.html（主库 + worker + cmap
# 全内联在里面，file:// 下 ESM 会被 CORS 拦），这几个独立文件谁都不读。
# 不进库是因为它们和 reader.html 内容重复，每次升级 PDF.js 都要多背 2 MB 历史。
# CI 在 npm ci 之后跑 `npm run prepare:pdf` 重新生成。
/assets/pdfjs/pdf.min.mjs
/assets/pdfjs/pdf.worker.min.mjs
/assets/pdfjs/cmaps/

# 本地日志与临时文件
*.log
err.txt

# 纯函数断言脚本的编译产物。
# 用通配而不是逐个列：断言一次建一个目录（.tmp-assert / .tmp-md / .tmp-sem…），
# 列表赶不上新目录，v0.8.7 就把 .tmp-md 提交进去了。
.tmp-*/
